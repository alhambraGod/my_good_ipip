  "metadata": {
    "name": "Holland-RIASEC-60",
    "full_name_en": "Holland Career Interest Inventory — 60-Item Version",
    "full_name_zh": "Holland职业兴趣量表 — 60题版",
    "version": "1.0",
    "source": "Based on Holland (1959, 1997) RIASEC Theory — Items adapted from IPIP Vocational Preference Inventory",
    "item_count": 60,
    "types_count": 6,
    "items_per_type": 10,
    "scale_type": "likert_5",
    "scale_options": [
      {
        "value": 1,
        "label_zh": "非常不感兴趣",
        "label_en": "Strongly Dislike"
      },
      {
        "value": 2,
        "label_zh": "比较不感兴趣",
        "label_en": "Dislike"
      },
      {
        "value": 3,
        "label_zh": "中立",
        "label_en": "Neutral"
      },
      {
        "value": 4,
        "label_zh": "比较感兴趣",
        "label_en": "Like"
      },
      {
        "value": 5,
        "label_zh": "非常感兴趣",
        "label_en": "Strongly Like"
      }
    ],
    "instruction_zh": "对于以下每项活动或职业，请选择你的感兴趣程度。不必考虑你是否有相关技能或经验，只需根据你的直觉反应作答。",
    "instruction_en": "For each activity or occupation below, indicate your level of interest. Do not consider whether you have the skills or experience — simply respond based on your gut feeling.",
    "scoring_note": "All items are forward keyed (+). Sum scores for each type (range 10-50). The three types with highest scores form your Holland Code (e.g., ISA, SEC). Match your code against occupational databases (e.g., O*NET).",
    "types": {
      "R": {
        "name_en": "Realistic",
        "name_zh": "现实型",
        "description_zh": "喜欢动手操作、使用工具和机械，偏好具体而非抽象的任务。",
        "core_traits_zh": [
          "动手能力强",
          "务实",
          "喜欢机械/技术",
          "重视有形成果"
        ],
        "typical_careers_zh": [
