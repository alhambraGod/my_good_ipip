# MindPrism — Environment Configuration
# Copy to .env (or env/{dev,prod}.env) and fill in your values.

# ── Core ──────────────────────────────────────────────────────────────
APP_ENV=dev                                  # dev | stage | prod
DATABASE_URL=sqlite:///./mindprism_dev.db
# For prod, point at a host or managed MySQL:
# DATABASE_URL=mysql+pymysql://mindprism:STRONG_PWD@host.docker.internal:3306/mindprism_prod?charset=utf8mb4

# ── Logging (centralised, rotating) ───────────────────────────────────
LOG_ROOT=/var/MindPrism                      # writes /var/MindPrism/<env>/logs/
LOG_RETENTION_DAYS=30

# ── URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001         # browser-facing API (used by /s/{code} short links)

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret              # MUST OVERRIDE IN PROD
OAUTH_STATE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Paywall gating ────────────────────────────────────────────────────
# When True, /api/v3/report/{id} returns the report even if unpaid (with
# is_preview=True for a watermark in the UI). Default: True in dev/test,
# False in prod. Override here if you want dev to be strict (= prod-like)
# or prod to allow free preview (= explicit risk).
ALLOW_FREE_REPORT=

# ── Payment provider registry ─────────────────────────────────────────
# See docs/PAYMENT_PROVIDERS.md for the full landscape.
PAYMENT_MODE=mock                            # back-compat single-driver: mock|razorpay|cashfree|payu|upi
PAYMENT_DEFAULT_DRIVER=                      # explicit override; default = PAYMENT_MODE
PAYMENT_DRIVERS_ENABLED=                     # comma list; e.g. "razorpay,upi,cashfree,mock"

# Razorpay (the recommended India primary)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (alternate India aggregator)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_BASE=https://sandbox.cashfree.com   # production: https://api.cashfree.com

# PayU India (form-POST redirect flow)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_API_BASE=https://test.payu.in              # production: https://secure.payu.in

# Direct UPI Intent (no aggregator, manual confirmation)
UPI_VPA=                                          # e.g. mindprism@hdfcbank
UPI_DISPLAY_NAME=MindPrism

# ── Pricing ───────────────────────────────────────────────────────────
PRICE_FULL_INR=99
PRICE_PROMO_INR=49
PROMO_MAX_REDEMPTIONS=1000

# ── Legacy / Stripe (international) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REPORT_PRICE_CENTS=399
REPORT_CURRENCY=usd

# ── OpenAI (template-based reports work without it) ───────────────────
OPENAI_API_KEY=
